# ── Copy file này thành .env và điền giá trị thật ──
# KHÔNG commit file .env lên git

# Django
DEBUG=False
SECRET_KEY=your-super-secret-key-change-this-in-production-min-50-chars
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (local docker-compose)
DB_NAME=phonestore_db
DB_USER=postgres
DB_PASSWORD=your-strong-db-password
DB_HOST=db
DB_PORT=5432

# Render/Neon — ưu tiên hơn DB_* nếu có
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Frontend origin (CORS + CSRF) — Render: https://phonestore-frontend.onrender.com
FRONTEND_URL=http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:80

# CORS (frontend URL) — base settings cũng có regex *.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80
